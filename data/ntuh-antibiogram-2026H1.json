    "period": "2026 上半年 (H1)",
    "period_bacteria": "2026-01 ~ 2026-06",
    "period_candida": "2026-01 ~ 2026-06",
    "value_meaning": "%S — 病人每月分離之第一株相同菌名細菌之抗生素感受性有效百分比 (susceptible %)",
    "codes": {
      "number": "%S (susceptible percentage)",
      "NA": "—: not available（報表該格為「－」，即未列／未測／無判讀標準）",
      "NI": "No interpretive criteria / not indicated"
    },
    "standards": {
      "bacteria": "CLSI M100 S34（本院檢驗醫學部自 7 月 1 日起採用）",
      "candida": "CLSI M38 / M51S"
    },
    "footnotes": {
      "SAM": "ampicillin-sulbactam",
      "TZP": "piperacillin-tazobactam",
      "cefazolin_urine": "CZ(U)：for uncomplicated UTIs",
      "cefazolin_other": "CZ(O)：for infections other than uncomplicated UTIs",
      "tigecycline": "判讀依據 FDA",
      "SXT": "sulfamethoxazole-trimethoprim",
      "AMC": "amoxicillin-clavulanic acid（本期報表未列）",
      "colistin": "有效%依 (I) intermediate 之結果呈現",
      "amikacin_urine": "AN(U)：Pseudomonas 的 amikacin 判讀僅適用於 urine 檢體",
      "gentamicin_high": "GMh：high-level gentamicin（enterococci synergy screen）",
      "chloramphenicol_gram_positive": "革蘭氏陽性表最末欄報表標為「CL」，依 2025 版同欄序與數值型態判定為 chloramphenicol（革蘭氏陰性表另有 C=chloramphenicol、CL=colistin 兩欄）"
    },
    "inclusion_rule": "本檔只收臨床常用且分離數足夠的菌列：革蘭氏陰性／陽性取院內常見致病菌與抗藥分層，厭氧菌取 n≥15，念珠菌取報表所列全部。報表另有兩百餘筆 n<15 之環境／罕見菌未收錄。",
    "not_imported": {
      "CZA_FDC_CTT_IPR": "ceftazidime-avibactam／cefiderocol／ceftolozane-tazobactam／imipenem-relebactam 四欄未匯入：屬選擇性送驗，分母不明且與分層互相矛盾（例：E. coli 全體 CZA 40%，但其 non-CRE 子群為 100%、CRE 子群為「－」，數學上不可能由同一分母得出），作為 antibiogram 使用會誤導。",
      "AM_gram_negative": "革蘭氏陰性表之 AM（ampicillin）僅 E. coli 有值（50%），且高於同菌之 ampicillin-sulbactam（35%），不合藥理，未匯入。",
      "CRO": "CRO（ceftriaxone）僅 E. coli 一列有值，沿用既有慣例以 CTX（cefotaxime）作第三代頭孢代表。",
      "TE_gram_negative": "革蘭氏陰性表之 TE（tetracycline）僅 Campylobacter／Helicobacter 等少數菌有值，未匯入。",
      "Neisseria_gonorrhoeae": "報表列 4 株，分離數過少未匯入。",
      "Morganella_morganii_colistin": "報表為 100%，但 CLSI M100 Appendix B 明列 Proteae（含 Morganella）對 polymyxin 為內生抗藥（同表 Serratia 亦正確顯示 0%），該格改為 NA。",
      "Stenotrophomonas_maltophilia_ceftazidime": "報表為 100%，但同列其餘 β-lactam（TZP／CMZ／CTX／FEP／ETP／IPM／MEM）全為 0%，與 L1 metallo-／L2 cephalosporinase 的抗藥表現不符；且本站菌譜表在無母欄時會以 %S 反推質性等級，照收會把 ceftazidime 對 S. maltophilia 由「不涵蓋」翻成「強效」，該格改為 NA。",
      "Candida_glabrata": "本期報表未列 Nakaseomyces glabrata（C. glabrata），故本檔無此菌；2025H1 曾有 n=16。"
    },
    "WARNING": "本資料由台大原始 PDF 報表以文字層＋欄位座標逐格抽取（368 列全數通過對位檢核），仍請於臨床決策前對照原始報表。分離數小時百分比極易受影響，徽章已附 n。"
  },

